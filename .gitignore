# ============================================================
# RANOVA Smart Plug - Root .gitignore
# ============================================================

# 1. Environment & Secret Keys (SANGAT RAHASIA - JANGAN DICOMMIT)
.env
.env.*
!.env.example
*.key
auth.json

# Firebase Service Account Credentials
*-adminsdk-*.json
serviceAccountKey.json
firebase-service-account.json

# 2. Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
.npm/
.pnpm-store/
vendor/

# 3. Microsoft Office Temporary & Lock Files (Saat Word/Excel Dibuka)
~$*
~$*.docx
~$*.xlsx
~$*.pptx

# 4. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Database & Local Storage
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
/storage/*.key
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

# 6. IDE, Editors & Local Tooling
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.codex/
.cursor/
.nova/
.zed/
.phpunit.cache/
.phpunit.result.cache
_ide_helper.php
Homestead.json
Homestead.yaml

# 7. Hardware, Microcontroller & Builds
.pio/
build/
dist/
*.hex
*.bin
*.elf
*.o
*.obj

# 8. Temporary & Backup Files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
getData()

# 9. Vercel & Deployment
.vercel

# 10. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 11. Local Documents, Raw Assets & Maintenance Scripts (Excluded from Git)
*.docx
*.doc
*.pptx
Tampilan 1.jpeg
Logo Fix.png
reset_firebase.ps1

