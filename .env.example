# ============================================================
# RANOVA Smart Plug - Environment Variables Template
# Salin file ini menjadi .env untuk pengembangan lokal
# File .env JANGAN dicommit ke GitHub!
# ============================================================

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://smartplug-4442d-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase Service Account (isi dengan SELURUH isi file JSON yang didownload dari Firebase Console)
# Ubah menjadi 1 baris string JSON
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"smartplug-4442d",...}

# Mayar API Key (dari https://web.mayar.id/api-keys)
MAYAR_API_KEY=your_mayar_api_key_here
